// Prisma schema for "Status Check".
// Single source of truth for the data model; all TS types are derived from here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The five commitment statuses required by the spec.
/// EXPIRED is stored in the enum but never set manually by the user — it is a
/// derived/effective status computed in `src/lib/status.ts` (getEffectiveStatus).
enum CommitmentStatus {
  TO_CHECK
  EXPIRED
  DONE
  NOT_ACTUAL
  IDEAS_BACKLOG
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  authoredCommitments  Commitment[] @relation("AuthoredCommitments")
  executingCommitments Commitment[] @relation("ExecutingCommitments")
  checkingCommitments  Commitment[] @relation("CheckingCommitments")
}

model Project {
  id          String       @id @default(cuid())
  name        String       @unique
  commitments Commitment[]
}

model Commitment {
  id          String           @id @default(cuid())
  title       String
  description String           @default("")
  createdAt   DateTime         @default(now())
  deadline    DateTime? // nullable: ideas backlog / no-deadline commitments
  isAllDay    Boolean          @default(true)
  status      CommitmentStatus @default(TO_CHECK)

  authorId String
  author   User   @relation("AuthoredCommitments", fields: [authorId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  executorId String
  executor   User   @relation("ExecutingCommitments", fields: [executorId], references: [id], onDelete: Restrict)

  checkerId String
  checker   User   @relation("CheckingCommitments", fields: [checkerId], references: [id], onDelete: Restrict)

  @@index([deadline])
  @@index([projectId])
  @@index([checkerId])
}
